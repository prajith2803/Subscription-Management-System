# ============================================================
# Subscription Management System – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://sms_user:sms_password@localhost:5432/sms_db?schema=public"
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_password
POSTGRES_DB=sms_db

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# --- Cookie ---
COOKIE_SECRET=change_this_to_another_long_random_secret

# --- App ---
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Email (optional – leave blank for dev preview mode) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Brightloop Software <noreply@brightloop.com>"

# --- Billing Scheduler ---
# Cron expression for automatic billing (default: every day at 1:00 AM)
BILLING_CRON=0 1 * * *

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

